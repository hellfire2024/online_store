{
  "name": "online-store-backend",
  "version": "1.0.0",
  "description": "Backend API server for Custom Threads Online Store",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "cd server && tsx watch src/server.ts",
    "build": "echo === STARTING BUILD === && cd server && echo [1/3] Installing server dependencies... && npm install && echo [2/3] Compiling TypeScript... && npm run build && cd .. && echo [3/3] Copying dist to root... && cp -r server/dist . && echo ✅ dist folder copied to root && ls -la dist/server.js && echo === BUILD COMPLETE ===",
    "postinstall": "npm run build",
    "start": "node dist/server.js",
    "db:migrate": "cd server && tsx src/db/migrate.ts",
    "db:seed": "cd server && tsx src/db/seed.ts",
    "db:reset": "cd server && tsx src/db/reset.ts"
  },
  "keywords": [
    "express",
    "mysql",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.9",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.6.5",
    "nodemailer": "^7.0.13",
    "react-chartjs-2": "^5.3.1",
    "stripe": "^20.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "uuid": "^13.0.0"
  }
}
