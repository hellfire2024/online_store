# Backend Dockerfile for Node/Express API (TypeScript)

# Build stage
FROM cgr.dev/chainguard/node:22-dev AS build
ENV DB_HOST=mysql
WORKDIR /app
COPY package.json .
COPY tsconfig.backend.json .
COPY demoRoutes.js .
COPY demoRoutes.d.ts .
COPY demoRoutes.d.ts.map .
COPY backend-src ./backend-src
COPY verify-build.js .
RUN npm install --frozen-lockfile || yarn install --frozen-lockfile
RUN npm run build

FROM cgr.dev/chainguard/node:22 AS runtime
ENV DB_HOST=mysql
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/verify-build.js ./verify-build.js
COPY --from=build /app/demoRoutes.js ./demoRoutes.js
COPY --from=build /app/demoRoutes.d.ts ./demoRoutes.d.ts
COPY --from=build /app/demoRoutes.d.ts.map ./demoRoutes.d.ts.map
COPY --from=build /app/backend-src/wait-for-mysql.sh ./backend-src/wait-for-mysql.sh
COPY --from=build /app/backend-src/healthcheck-debug.sh ./backend-src/healthcheck-debug.sh
COPY --from=build /app/backend-src/db/site_settings.json ./db/site_settings.json
COPY --from=build /app/backend-src/healthcheck.js ./healthcheck.js
RUN chmod +x /app/healthcheck.js
EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=5 \
    CMD node /app/healthcheck.js || exit 1
CMD ["node", "dist/server.js"]
