# Backend Dockerfile for Node/Express API (TypeScript)
FROM node:20-alpine AS build
ENV DB_HOST=mysql
WORKDIR /app
COPY package.json .
COPY tsconfig.backend.json .
COPY backend-src ./backend-src
COPY verify-build.js .
RUN npm install --frozen-lockfile || yarn install --frozen-lockfile
RUN npm run build

FROM node:20-alpine
RUN apk add --no-cache curl
ENV DB_HOST=mysql
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/verify-build.js ./verify-build.js
COPY --from=build /app/backend-src/wait-for-mysql.sh ./backend-src/wait-for-mysql.sh
COPY backend-src/healthcheck-debug.sh ./backend-src/healthcheck-debug.sh
COPY backend-src/db ./backend-src/db
CMD ["node", "dist/server.js"]
EXPOSE 3001
