# Copy this file to .env and fill in all values.
# NEVER commit .env to git.

# ── App ──────────────────────────────────────────────
NODE_ENV=production
APP_ENV=dev
PORT=3001

# ── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=youruser
DB_PASSWORD=yourpassword
DB_NAME=yourdb_dev

# MySQL Docker variables (must match DB_* above)
MYSQL_USER=youruser
MYSQL_PASSWORD=yourpassword
MYSQL_DATABASE=yourdb_dev
MYSQL_ROOT_PASSWORD=change_this_root_password

# ── Auth ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret_min_32_chars

# ── Initial Admin (seeded once on first deploy) ───────
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe1!SuperAdmin
INITIAL_ADMIN_EMAIL=admin@example.com

# ── CORS / URLs ───────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
SERVICE_URL_BACKEND=http://localhost:3001
SERVICE_URL_FRONTEND=http://localhost:5173

# ── Email ─────────────────────────────────────────────
# Configure SMTP credentials via Admin Panel > Settings > Email
CONTACT_EMAIL=contact@example.com
# AES-256 key for encrypting stored SMTP passwords and API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=replace_with_64_char_hex_string

# ── Frontend (Vite) ───────────────────────────────────
VITE_API_URL=http://localhost:3001/api
VITE_ENABLE_AI_FEATURES=false

# Gemini AI (optional) — set VITE_ENABLE_AI_FEATURES=true to enable
VITE_GEMINI_API_KEY=
