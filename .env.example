# Frontend Environment Variables

# API Configuration
VITE_API_URL=https://devapi.adaptivegis.com/api

# Feature Flags
VITE_ENABLE_AI_FEATURES=true

# Google Generative AI (Gemini)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend Environment Variables
NODE_ENV=production
PORT=3001
DB_HOST=devapi.adaptivegis.com
DB_PORT=3306
DB_USER=youruser
DB_PASSWORD=yourpassword
DB_NAME=yourdb
JWT_SECRET=your_jwt_secret
# Contact Form Recipient Email
CONTACT_EMAIL=tgaunt@adaptivegis.com

# Email Configuration (configure via Admin Panel > Email Settings)
# For Zoho Mail SMTP:
# Host: smtp.zoho.com
# Port: 465 (SSL) or 587 (TLS)
# Secure: true for port 465, false for port 587
# Username: your full Zoho email address (e.g., tgaunt@adaptivegis.com)
# Password: your Zoho mail password or app-specific password